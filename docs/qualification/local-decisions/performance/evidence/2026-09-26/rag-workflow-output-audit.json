corded separately after observing outputs."],"method":"assistant review of all saved final outputs against exact arithmetic; assertions cover only these known text forms","qualifiedForRouting":false,"referenceSha256":"c0e1dff24dc957b7229e56cb87183e07d775ed5f02a59224fbfa9e8af5c33a4e","resultSha256":"9e78d514816216708dda94bfb88acfbee4307ac160ed076e3bef144fa97650be","routingEnabled":false,"schemaVersion":"agat.decision.rag-output-audit.v1","sha256":"b33e1b5feb9288a686d45e65bcbe4936bdb28efed06395f95a3f14e6e4e8993f","sourceMapping":"two known authored sentences, not general natural-language extraction","sourceSpans":[{"end":97,"quote":"Июль: 100 заявок, 400 часов обработки, 8 заявок с отклонением.","sourceId":"july","sourceSha256":"20e43016c5e962ccf0d81b79b4b967e26440e9f9c7645446d94258bb9b7a41f7","start":35},{"end":101,"quote":"Август: 120 заявок, 360 часов обработки, 6 заявок с отклонением.","sourceId":"august","sourceSha256":"5b871b2b5ab30346a94f5ed1b1891d5b69e76245a6ffd6651a9af891233fcbaa","start":37}],"uiAtMeasurement":{"content":"import { knowledgeSourceHref, knowledgeSourceLocation } from \"../knowledge\";\nimport type { KnowledgeSource, Stage } from \"../types\";\n\nexport function KnowledgeLinkedOutput({ text, sources }: { text: string; sources: KnowledgeSource[] }) {\n  return <pre>{text.split(/(\\[K\\d+\\])/g).map((part, index) => {\n    const matches = sources.filter((source) => `[${source.marker}]` === part);\n    // Legacy runs may reuse K1 in different stages; never guess which source it means.\n    return matches.length === 1 ? <a key={index} href={knowledgeSourceHref(matches[0]!)} title={matches[0]!.provenance.documentName}>{part}</a> : part;\n  })}</pre>;\n}\n\nexport function KnowledgeSources({ sources, stages }: { sources: KnowledgeSource[]; stages: Stage[] }) {\n  if (!sources.length) return null;\n  return <section className=\"knowledge-sources\" aria-label=\"Источники результата\">\n    <h4>Источники Knowledge</h4>\n    <p>Фрагменты, переданные модели. Откройте документ, чтобы проверить выводы отчёта.</p>\n    {sources.map((source) => <details key={`${source.retrievalId}:${source.marker}`}>\n      <summary><span>[{source.marker}] </span><a href={knowledgeSourceHref(source)}>{source.provenance.documentName} · {knowledgeSourceLocation(source)}</a>\n        <small>Этап: {stages.find((stage) => stage.id === source.stageId)?.agent.name ?? source.stageId}</small></summary>\n      <blockquote>{source.content ?? source.excerpt}</blockquote>\n      <small>Символы {source.provenance.charStart}–{source.provenance.charEnd} · SHA-256 фрагмента: <code>{source.provenance.chunkSha256}</code></small>\n    </details>)}\n  </section>;\n}\nimport React from \"react\";\n","path":"apps/web/src/components/KnowledgeSources.tsx","sha256":"d3f777c5e19823c899309ed4a6345944e62c10823996480018e9c406652d29e6"}}
