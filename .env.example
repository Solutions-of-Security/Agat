AGAT_HOST=127.0.0.1
AGAT_PORT=8787
# Published localhost port for Docker Compose; the container listens on 8787.
AGAT_HTTP_PORT=8787
AGAT_DB_PATH=./data/agat.db
AGAT_ENROLLMENT_TOKEN=replace-with-a-long-random-token
AGAT_ADMIN_TOKEN=
AGAT_SEARCH_SECRET=replace-with-another-long-random-token
AGAT_SEED_DEMO=false
AGAT_SERVE_WEB=true
AGAT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGAT_CREDENTIALS_KEY=replace-with-a-long-random-secret
AGAT_SANDBOX_ENABLED=false
AGAT_SANDBOX_NAMESPACE=agat
AGAT_SANDBOX_WASI_IMAGE=agat-local/sandbox-wasi:1.6.0
AGAT_SANDBOX_RUNTIME_CLASS=
AGAT_SANDBOX_NETWORK_POLICY_ENFORCED=false
AGAT_A2A_ENABLED=true
AGAT_A2A_PUBLIC_BASE_URL=http://127.0.0.1:8787
AGAT_A2A_OUTBOUND_ENABLED=true
AGAT_A2A_ALLOW_LOOPBACK_OUTBOUND=false
AGAT_A2A_OUTBOUND_TIMEOUT_SECONDS=15
AGAT_A2A_MAX_RESPONSE_BYTES=1048576
AGAT_EDGE_ENABLED=false
AGAT_EDGE_ATTESTATION_MODE=disabled
AGAT_EDGE_ATTESTATION_BROKER_URL=
AGAT_EDGE_ATTESTATION_BROKER_TOKEN=
AGAT_EDGE_ATTESTATION_TIMEOUT_SECONDS=10
AGAT_EDGE_CHALLENGE_TTL_SECONDS=180
AGAT_EDGE_ANDROID_APPLICATION_ID=io.agat.edge
AGAT_EDGE_IOS_APPLICATION_ID=TEAMID.io.agat.edge
AGAT_EDGE_ALLOW_DEVELOPMENT_ATTESTATION=false
AGAT_EDGE_ANDROID_REQUIRED_VERDICTS=MEETS_DEVICE_INTEGRITY,PLAY_RECOGNIZED
AGAT_EDGE_IOS_REQUIRED_VERDICTS=APP_ATTEST_VALID
AGAT_TEMPORAL_ENABLED=false
AGAT_TEMPORAL_ADDRESS=127.0.0.1:7233
AGAT_TEMPORAL_NAMESPACE=agat
AGAT_TEMPORAL_TASK_QUEUE=agat-processes-v1
AGAT_TEMPORAL_INTERNAL_TOKEN=replace-with-a-long-random-secret
AGAT_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AGAT_OTEL_COORDINATOR_SERVICE_NAME=agat-coordinator
AGAT_OTEL_WORKER_SERVICE_NAME=agat-worker
AGAT_MODEL_DISCOVERY=auto
AGAT_MODEL_PROFILES_JSON=
AGAT_EMBEDDING_MODELS=embeddinggemma
AGAT_LOCAL_WORKER_EMBEDDING_MODELS=embeddinggemma
AGAT_WORKER_GPU=
AGAT_WORKER_VRAM_MB=0
AGAT_WORKER_VRAM_USED_MB=
AGAT_WORKER_POWER_WATTS=
AGAT_WORKER_TEMPERATURE_C=
AGAT_WORKER_BATTERY_PERCENT=
AGAT_WORKER_ON_BATTERY=false
